<Window x:Class="drone_control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Drone Control Center" Height="700" Width="1280"
        MinHeight="650" MinWidth="1100"
        WindowState="Maximized"
        Background="#0F172A" TextElement.Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style cho GroupBox Dark Mode -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="#1E293B" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#334155" CornerRadius="7,7,0,0" Padding="12,6">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                </Border>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="overlay" CornerRadius="6" Background="White"
                            Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Rê chuột: sáng nhẹ -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="overlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <!-- Đang nhấn: tối rõ. Nhả ra thì tự về như cũ -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="overlay" Property="Background" Value="Black"/>
                                <Setter TargetName="overlay" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho TextBox nhập PID -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- Ô hiển thị số liệu (dùng chung cho mọi thẻ) -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- Khối con (PID Angle / PID Yaw / set zero) -->
        <Style x:Key="Block" TargetType="Border">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- ================= 1. TOP BAR (CONNECT & STATUS) ================= -->
        <Border DockPanel.Dock="Top" Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="DRONE VVT" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <Label Content="Cổng COM:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cbPort" Width="140" Margin="4,0,8,0" VerticalAlignment="Center" Height="32"/>
                    <Button x:Name="btnRefresh" Content="↻ Quét COM" Width="100" Height="32" Background="#475569" Click="BtnRefresh_Click"/>
                    <Button Content="⚡ Connect" Width="110" Height="32" Background="#22C55E" Margin="8,0,0,0" Click="Connect_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>
                    <TextBlock Text="Disconnected" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT: ĐỒ THỊ (TRÁI) | ĐIỀU KHIỂN (PHẢI) ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT TRÁI: ĐỒ THỊ (cao hết khung) ================= -->
            <GroupBox Grid.Column="0" Header="ĐỒ THỊ THỜI GIAN THỰC" FontSize="14" FontWeight="Bold" Margin="0">
                <lvc:CartesianChart Series="{Binding DroneSeries}" DisableAnimations="True" Hoverable="False" Loaded="CartesianChart_Loaded">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Title="Thời gian" ShowLabels="True"/>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="Góc (°)" MaxValue="50" MinValue="-50" LabelFormatter="{Binding YFormatter}" ShowLabels="True"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </GroupBox>

            <!-- ================= CỘT PHẢI: TELEMETRY (trên) + PID | FLIGHT (dưới) ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Thông số giám sát (trải 2 cột) ===== -->
                <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Header="THÔNG SỐ GIÁM SÁT" FontSize="14" FontWeight="Bold" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Góc Attitude -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Góc Attitude (°)" Foreground="#64748B" FontSize="11" Margin="4,0,0,2"/>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Label Content="ROLL" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Name="roll" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Label Content="PITCH" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Name="pitch" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Label Content="YAW" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Name="yaw" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Tọa độ & Độ cao -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tọa độ &amp; Độ cao" Foreground="#64748B" FontSize="11" Margin="4,0,0,2"/>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Label Content="X (m)" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Name="x" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#FACC15" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Label Content="Y (m)" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Name="y" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#FACC15" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Label Content="HEIGHT (m)" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Name="h" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- ===== Cấu hình PID & góc cân bằng ===== -->
                <GroupBox Grid.Row="2" Grid.Column="0" Header="CẤU HÌNH PID &amp; GÓC CÂN BẰNG" FontSize="14" FontWeight="Bold" Margin="0">
                    <UniformGrid Columns="1">

                        <!-- 1. PID Angle -->
                        <Border Style="{StaticResource Block}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PID Angle" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="3">
                                        <Label Content="Kp" Padding="0,0,0,2"/>
                                        <DockPanel>
                                            <Button Content="◀" Width="24" Height="28" Click="giam_kp" Background="#334155"/>
                                            <Button Content="▶" Width="24" Height="28" DockPanel.Dock="Right" Click="tang_kp" Background="#334155"/>
                                            <TextBox Name="kp" Text="0" Height="28" TextChanged="kp_TextChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3">
                                        <Label Content="Ki" Padding="0,0,0,2"/>
                                        <DockPanel>
                                            <Button Content="◀" Width="24" Height="28" Click="giam_ki" Background="#334155"/>
                                            <Button Content="▶" Width="24" Height="28" DockPanel.Dock="Right" Click="tang_ki" Background="#334155"/>
                                            <TextBox Name="ki" Text="0" Height="28" TextChanged="ki_TextChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="3">
                                        <Label Content="Kd" Padding="0,0,0,2"/>
                                        <DockPanel>
                                            <Button Content="◀" Width="24" Height="28" Click="giam_kd" Background="#334155"/>
                                            <Button Content="▶" Width="24" Height="28" DockPanel.Dock="Right" Click="tang_kd" Background="#334155"/>
                                            <TextBox Name="kd" Text="0" Height="28" TextChanged="kd_TextChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. PID Yaw -->
                        <Border Style="{StaticResource Block}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PID Yaw" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="3">
                                        <Label Content="Kp" Padding="0,0,0,2"/>
                                        <DockPanel>
                                            <Button Content="◀" Width="24" Height="28" Click="giam_kpr" Background="#334155"/>
                                            <Button Content="▶" Width="24" Height="28" DockPanel.Dock="Right" Click="tang_kpr" Background="#334155"/>
                                            <TextBox Name="kpr" Text="0" Height="28" TextChanged="kpr_TextChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3">
                                        <Label Content="Ki" Padding="0,0,0,2"/>
                                        <DockPanel>
                                            <Button Content="◀" Width="24" Height="28" Click="giam_kir" Background="#334155"/>
                                            <Button Content="▶" Width="24" Height="28" DockPanel.Dock="Right" Click="tang_kir" Background="#334155"/>
                                            <TextBox Name="kir" Text="0" Height="28" TextChanged="kir_TextChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="3">
                                        <Label Content="Kd" Padding="0,0,0,2"/>
                                        <DockPanel>
                                            <Button Content="◀" Width="24" Height="28" Click="giam_kdr" Background="#334155"/>
                                            <Button Content="▶" Width="24" Height="28" DockPanel.Dock="Right" Click="tang_kdr" Background="#334155"/>
                                            <TextBox Name="kdr" Text="0" Height="28" TextChanged="kdr_TextChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. ROLL PITCH set zero -->
                        <Border Style="{StaticResource Block}" Margin="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ROLL PITCH YAW set zero" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="3">
                                        <Label Content="roll_z" Padding="0,0,0,2"/>
                                        <DockPanel>
                                            <Button Content="◀" Width="24" Height="28" Click="giam_roll_z" Background="#334155"/>
                                            <Button Content="▶" Width="24" Height="28" DockPanel.Dock="Right" Click="tang_roll_z" Background="#334155"/>
                                            <TextBox Name="roll_z" Text="0.0" Height="28" TextChanged="roll_z_TextChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3">
                                        <Label Content="pitch_z" Padding="0,0,0,2"/>
                                        <DockPanel>
                                            <Button Content="◀" Width="24" Height="28" Click="giam_pitch_z" Background="#334155"/>
                                            <Button Content="▶" Width="24" Height="28" DockPanel.Dock="Right" Click="tang_pitch_z" Background="#334155"/>
                                            <TextBox Name="pitch_z" Text="0.0" Height="28" TextChanged="pitch_z_TextChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </UniformGrid>
                </GroupBox>

                <!-- ===== Bảng điều khiển bay ===== -->
                <GroupBox Grid.Row="2" Grid.Column="2" Header="BẢNG ĐIỀU KHIỂN BAY" FontSize="14" FontWeight="Bold" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Số liệu bay -->
                        <UniformGrid Grid.Row="0" Columns="2">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Label Content="SPEED:" FontSize="11"/>
                                    <TextBlock Name="speed" Text="0" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                                    <Label Content="%" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Label Content="ROTA:" FontSize="11"/>
                                    <TextBlock Name="rota" Text="0" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                                    <Label Content="°/s" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Label Content="roll_F:" FontSize="11"/>
                                    <TextBlock Name="roll_F" Text="0" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                                    <Label Content="°" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Label Content="pitch_F:" FontSize="11"/>
                                    <TextBlock Name="pitch_F" Text="0" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                                    <Label Content="°" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Hàng 1: D-pad (trái) + xoay left/right (phải) -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="132" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="1" Name="tien" Content="▲" Focusable="False" Click="tien_Click" Background="#475569"/>
                                <Button Grid.Row="1" Grid.Column="0" Name="trai" Content="◀" Focusable="False" Background="#475569"/>
                                <Button Grid.Row="1" Grid.Column="1" Name="rs" Content="RS" FontWeight="Bold" Focusable="False" Background="#DC2626"/>
                                <Button Grid.Row="1" Grid.Column="2" Name="phai" Content="▶" Focusable="False" Background="#475569"/>
                                <Button Grid.Row="2" Grid.Column="1" Name="lui" Content="▼" Focusable="False" Background="#475569"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="left" Width="62" Height="62" Name="left" Background="#475569" Focusable="False" Click="left_Click"/>
                                <Button Content="right" Width="62" Height="62" Name="right" Background="#475569" Focusable="False" Click="right_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 2: UP/DOWN (trái) + ZW SET/RUN (phải) -->
                        <UniformGrid Grid.Row="2" Columns="2" HorizontalAlignment="Center">
                            <Button Content="▲ UP" Width="104" Height="44" Margin="4" Name="up" Background="#059669" Focusable="False"/>
                            <Button Content="ZW SET" Width="104" Height="44" Margin="4" Name="set" Background="#0284C7" Click="set_Click"/>
                            <Button Content="▼ DOWN" Width="104" Height="44" Margin="4" Name="down" Background="#D97706" Focusable="False"/>
                            <Button Content="RUN" Width="104" Height="44" Margin="4" Name="run" Background="#16A34A" Click="runc"/>
                        </UniformGrid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
